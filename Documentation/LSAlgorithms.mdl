|agp=<<const>> get_$BASICNAME():const $TYPE
|agp_body=return $NAME;
|asp=set_$BASICNAME(value:$TYPE):void
|asp_body=$NAME = value;|return;
|agr=<<const>> get_$BASICNAME():const $TYPE
